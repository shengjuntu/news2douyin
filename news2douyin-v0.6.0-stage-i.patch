+        const b=node('button',title,'ghost');b.type='button';b.dataset.boundary=String(bodyIndex+delta<0||bodyIndex+delta>=draftStructure.segments.length);
+        b.onclick=()=>{const i=bodyIndex+delta;[draftStructure.segments[i],draftStructure.segments[bodyIndex]]=[block,draftStructure.segments[i]];renderStructure();changedStructure();};head.append(b);
+      }
+      const remove=node('button','删除段落','ghost');remove.type='button';remove.dataset.boundary=String(draftStructure.segments.length===1);
