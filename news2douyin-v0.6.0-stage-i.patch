+    check.dataset.id=block.id;check.dataset.hash=block.hash;check.dataset.invalid=block.issues.length?'1':'';check.onchange=controls;
+    label.append(check,document.createTextNode(' 已核对 '+block.id+' · '+kindNames[block.kind]+'：'+block.spoken.slice(0,90)));
+    root.append(label);
+    if(block.issues.length)root.append(node('p',block.issues.join('；'),'evidence-issue'));
+    if(block.snapshot_only)root.append(node('p','此段引用的是旧稿快照，未记录文章版本号。','muted small'));
+  }
+}
+function renderStructure() {
