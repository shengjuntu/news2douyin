+function syncNarration() { if(draftStructure)byId('script-text').value=flattenDraft(); }
+function changedStructure() { syncNarration();markDirty(); }
+function blockField(parent,label,tag,value,onChange) {
+  const wrapper=node('label',undefined,'field');wrapper.append(node('span',label));
+  const input=node(tag);input.value=value||'';if(tag==='textarea')input.rows=3;else input.type='text';
+  input.setAttribute('aria-label',label);input.oninput=()=>{onChange(input.value);changedStructure();};
+  wrapper.append(input);parent.append(wrapper);return input;
+}
+function renderEvidenceReview() {
+  const root=byId('segment-review');root.replaceChildren();
+  if(!current.document.structure)return;
