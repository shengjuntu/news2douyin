# Loaded by CLI and server; process environment variables take precedence.
# Copy to .env and fill in real values. NEVER commit .env.
API_KEY=
OPENAI_API_KEY=vllm
OPENAI_BASE_URL=http://127.0.0.1:19993/v1
MODEL=MiniCPM5-2B
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-large
EMBEDDING_API_KEY=
USE_LLM_CACHE=false
LLM_CACHE_DB=./runs/openai_cache.db
LLM_CACHE_RATIO=0.9
DEDUP_LLM_ENABLED=1

# Optional explicit environment file: NEWS2DOUYIN_ENV_FILE=/path/to/.env
DEDUP_LLM_TIMEOUT=30

# Daily selection and date filters; scheduled jobs use their own timezone.
NEWS2DOUYIN_TIMEZONE=Asia/Shanghai
