# Loaded by CLI and server; process environment variables take precedence.
# Copy to .env and fill in real values. NEVER commit .env.
# Transaction store: PostgreSQL for formal service; blank keeps SQLite compatibility.
# postgresql:// is normalized to postgresql+psycopg://. URL-encode URL credentials.
NEWS2DOUYIN_DATABASE_URL=
# Formal deployment sets this to 1: a missing/non-PG default URL fails before
# any old SQLite file can be opened. Keep 0 for local SQLite development.
NEWS2DOUYIN_DATABASE_REQUIRE_POSTGRES=0
NEWS2DOUYIN_DB_LOCK_TIMEOUT_MS=2000
NEWS2DOUYIN_DB_STATEMENT_TIMEOUT_MS=15000
# Leave capacity blank for backend defaults: PostgreSQL 8+8, SQLite file 5+10.
# These set resident pool size and extra concurrent connections, not query speed.
# Size range 1..64, overflow 0..64; a measured workload may use 30+60.
NEWS2DOUYIN_DB_POOL_SIZE=
NEWS2DOUYIN_DB_MAX_OVERFLOW=
# Seconds waiting to obtain a pool connection (0..300), distinct from SQL/lock timeout.
# In-memory SQLite keeps its native pool and ignores these QueuePool settings.
NEWS2DOUYIN_DB_POOL_TIMEOUT=10
# Named SQL observations: cursor execution time only; no SQL text/parameters.
# Statistics stay in process memory (latest 128 operation names), reset on restart.
NEWS2DOUYIN_DB_SLOW_QUERY_MS=250
# Optional X-DB-Query-Count / X-DB-Time-Ms response headers; default off.
NEWS2DOUYIN_DB_QUERY_HEADERS=0
# SQLite compatibility only; WAL is enabled by the application.
NEWS2DOUYIN_SQLITE_BUSY_TIMEOUT_MS=30000
# Formal deploy/production.compose.yaml builds its own internal PostgreSQL URL.
# Generate a URL-safe value: python -c "import secrets; print(secrets.token_hex(32))"
# Required by formal Compose; changing it does not rotate an existing PG role password.
NEWS2DOUYIN_POSTGRES_PASSWORD=
# Formal Compose: use the absolute path to the EXISTING storage_root when upgrading.
# Default when blank is the source root's runs_v7. Never share this directory across apps.
NEWS2DOUYIN_DATA_DIR=
# Container mount target/startup --storage-root. Keep the original absolute path
# when historical database rows refer to files there. New installations use /data.
NEWS2DOUYIN_STORAGE_ROOT=/data
NEWS2DOUYIN_HTTP_BIND=127.0.0.1
NEWS2DOUYIN_HTTP_PORT=18080
API_KEY=
OPENAI_API_KEY=vllm
OPENAI_BASE_URL=http://127.0.0.1:19993/v1
MODEL=MiniCPM5-2B
EMBEDDING_BASE_URL=
# Use the exact advertised ID. Leave blank for a server with a single model.
EMBEDDING_MODEL=
# Optional output shape guard. Use 1024 for a full-size BGE-M3 vector.
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=
USE_LLM_CACHE=false
LLM_CACHE_DB=./runs/openai_cache.db
LLM_CACHE_RATIO=0.9
# Optional explicit environment file: NEWS2DOUYIN_ENV_FILE=/path/to/.env

# Daily selection and date filters; scheduled jobs use their own timezone.
NEWS2DOUYIN_TIMEZONE=Asia/Shanghai

# Required for the complete event radar and persistent focus graph.
# deploy/falkordb.compose.yaml binds only to localhost by default.
# Blank selects the private service in formal Compose. For a local app with the
# standalone graph Compose, set redis://127.0.0.1:16379 explicitly.
# Upgrading: retain the existing graph and use an address reachable FROM the app.
NEWS2DOUYIN_FALKOR_URL=
NEWS2DOUYIN_GRAPH_PREFIX=n2d
# Read limits for the graph explorer only. Each value is in milliseconds.
NEWS2DOUYIN_GRAPH_EXPLORER_QUERY_TIMEOUT_MS=600
NEWS2DOUYIN_GRAPH_EXPLORER_BUDGET_MS=1800
NEWS2DOUYIN_GRAPH_EXPLORER_SOCKET_TIMEOUT_MS=1000
# External graph work uses a renewable SQL lease, not a long SQL transaction.
NEWS2DOUYIN_GRAPH_LEASE_SEC=120
# Document-context extraction follows the rule baseline; configure the model above.
# Use rules only for an explicitly limited offline baseline.
NEWS2DOUYIN_EVENT_READER=model

# Optional web entry; configurable in /knowledge/browser too. Use a host reachable by your browser.
NEWS2DOUYIN_FALKOR_BROWSER_URL=
NEWS2DOUYIN_FALKOR_BROWSER_PORT=13000
NEWS2DOUYIN_FALKOR_BROWSER_BIND=127.0.0.1

# Applies to DOC and all six full GDELT Events/Mentions/GKG streams.
NEWS2DOUYIN_GDELT_CONNECT_TIMEOUT=30
NEWS2DOUYIN_GDELT_READ_TIMEOUT=90
# Generic master switch: blank follows the legacy GKG setting below. An explicit
# 0/1 overrides the legacy value. Individual streams are controlled on /intake.
NEWS2DOUYIN_GDELT_STREAM_ENABLED=
# Full raw intake defaults on; retained as the compatibility master switch.
NEWS2DOUYIN_GKG_STREAM_ENABLED=1
# Generic working-index projection master: blank follows the legacy switch.
NEWS2DOUYIN_GDELT_PROJECTION_ENABLED=
# Pause projections while raw intake continues; compatibility name retained.
NEWS2DOUYIN_GKG_PROJECTION_ENABLED=1
# Default GKG discovery keeps the document catalog, not per-article local events.
# Set1 only for legacy automatic-event compatibility. Existing linked materials still update.
NEWS2DOUYIN_GKG_AUTO_EVENTS=0
# Bounded working-index transactions; these never truncate raw intake.
NEWS2DOUYIN_GKG_PROJECTION_CHUNK=25
NEWS2DOUYIN_GKG_PROJECTION_BUDGET_MS=250
# Optional busy interval override, e.g.0.05 on PostgreSQL; blank follows old explicit
# setting below. With neither setting, PostgreSQL defaults0.05s and SQLite1s.
NEWS2DOUYIN_GDELT_PROJECTION_INTERVAL=
NEWS2DOUYIN_GKG_PROJECTION_INTERVAL=1
NEWS2DOUYIN_GKG_PROJECTION_IDLE_INTERVAL=3
# Required for other applications calling POST /api/intake/documents.
NEWS2DOUYIN_INTAKE_TOKEN=
# Optional language labels and per-provider mappings, visible to the service.
# NEWS2DOUYIN_LANGUAGE_CONFIG=/data/languages.toml
# Oversized batches fail visibly without truncating; raise only for capacity you can retain.
NEWS2DOUYIN_GKG_MAX_ARCHIVE_BYTES=268435456
NEWS2DOUYIN_GKG_MAX_EXPANDED_BYTES=1073741824

# NewsNow attention topics: background archive observations, rule grouping and
# bounded GDELT candidate matching. Disable this derived worker only; existing
# articles, raw archives and the original collection schedules remain intact.
# One app process owns the local attention DuckDB. HTTP reads use SQL summaries.
NEWS2DOUYIN_ATTENTION_ENABLED=1

# Graph index readiness is checked automatically by the background worker.
# Keep idle waiting and error backoff; no parallel writers are enabled.
NEWS2DOUYIN_GRAPH_SUCCESS_INTERVAL=0.01
# Focus projection yields its lease between batches. Time is a soft budget
# checked between items; one graph command can run longer than that budget.
NEWS2DOUYIN_GRAPH_FOCUS_BATCH_SIZE=8
NEWS2DOUYIN_GRAPH_FOCUS_BATCH_MS=500
# One-time legacy topic inventory queries have a separate server timeout.
NEWS2DOUYIN_GRAPH_FOCUS_QUERY_TIMEOUT_MS=1000
# Disable only orphan GC, retaining its checkpoint; intake/projection continue.
NEWS2DOUYIN_GRAPH_GC_ENABLED=1
NEWS2DOUYIN_GRAPH_GC_TICK_SECONDS=2
NEWS2DOUYIN_GRAPH_GC_BATCH_SIZE=50
NEWS2DOUYIN_GRAPH_GC_WINDOW=1024
NEWS2DOUYIN_GRAPH_GC_INTERVAL_SEC=300
NEWS2DOUYIN_GRAPH_GC_QUERY_TIMEOUT_MS=500

# Background source headline/excerpt previews for the global event radar.
# Local saved reporting is used first; remote pages are bounded public-source reads.
# Disable remote/background enrichment without changing raw GDELT intake.
NEWS2DOUYIN_SOURCE_CONTENT_ENABLED=1

# Generate rolling editions for today (Beijing time), then close them when the day ends.
NEWS2DOUYIN_DIGEST_ENABLED=1
# Produce the companion video edition on the daily schedule. By default, it runs on request.
NEWS2DOUYIN_VIDEO_DIGEST_AUTOMATIC=0
# Optional TOML file visible to the daily worker. Each build reads the file once.
# NEWS2DOUYIN_SELECTION_CONFIG=/data/daily-selection.toml

# Optional missing-report enrichment with gdeltnews; the standard image includes it.
# Unset enables when the extra is installed. Set 0 to pause this worker.
# NEWS2DOUYIN_NGRAMS_ENABLED=0
# Use 0 to consult only cached official minute archives.
NEWS2DOUYIN_NGRAMS_ALLOW_DOWNLOAD=1
NEWS2DOUYIN_NGRAMS_MINUTES=15
NEWS2DOUYIN_NGRAMS_BATCHES_PER_DAY=96
NEWS2DOUYIN_NGRAMS_AUTO_TARGETS_PER_DAY=64
